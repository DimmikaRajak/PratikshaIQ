# Supabase Client Configuration (Public / Anon Key — safe for browser with RLS enabled)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase Server-Only Credentials (NEVER prefix with VITE_ or expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini API Key (Server-side only — optional for visit preparation guidance)
GEMINI_API_KEY=

# Public Application URL (used for auth redirect callbacks and links)
APP_URL=http://localhost:3000

# Optional: Custom User-Agent contact email for OpenStreetMap Nominatim/Overpass policy compliance
OSM_CONTACT_EMAIL=
